# ==========================================
# Triad Care Environment Variables Configuration
# ==========================================

# Backend (FastAPI)
# -----------------
# Google Gemini API key for prescription OCR and weekly adherence digest.
# If omitted or invalid, the platform automatically engages its graceful demo fallback
# and displays clear simulated insights without failing.
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite async by default for seamless local hackathon demo;
# structured for PostgreSQL/Supabase migration)
DATABASE_URL=sqlite+aiosqlite:///./caresync.db

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Frontend (Vite)
# ---------------
# API base URL pointing to the FastAPI backend
VITE_API_URL=http://localhost:8000
